@model Football_Management.ViewModels.Fixtures.DetailMatchViewModel
@{
    ViewData["Title"] = "Detail";
}

@functions {
    public static string GetOrdinalSuffix(int day)
    {
        if (day % 100 >= 11 && day % 100 <= 13)
        {
            return $"{day}th";
        }
        else if (day % 10 == 1)
        {
            return $"{day}st";
        }
        else if (day % 10 == 2)
        {
            return $"{day}nd";
        }
        else if (day % 10 == 3)
        {
            return $"{day}rd";
        }
        else
        {
            return $"{day}th";
        }
    }
}

<div class="container mt-5 match-detail">
    <h1 class="text-center">Match Result</h1>

    <div class="match-details mt-4 text-center">
        <div class="row align-items-center">
            <div class="col-6 text-right">
                <div class="team">
                    <a asp-controller="Clubs" asp-action="Squad" asp-route-id="@Model.HomeTeamId" style="color: black">
                        <h2 class="team-name d-inline">@Model.HomeTeam</h2>
                        <img src="~/Assets/images/logo/@Model.LogoHUrl" alt="Logo" class="team-logo d-inline">
                    </a>
                </div>
            </div>
            <div class="col-6 text-left">
                <div class="team">
                    <a asp-controller="Clubs" asp-action="Squad" asp-route-id="@Model.AwayTeamId" style="color: black">
                        <img src="~/Assets/images//logo/@Model.LogoAUrl" alt="Logo" class="team-logo d-inline">
                        <h2 class="team-name d-inline">@Model.AwayTeam</h2>
                    </a>
                </div>
            </div>
        </div>
        <div class="score mt-3 d-flex justify-content-center align-items-center">
            <h2 class="score-number">@Model.TimeStart</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-12 text-center">
                <div id="countdown">
                    <span id="days">0</span> Days
                    <span id="hours">0</span> Hrs
                    <span id="minutes">0</span> Mins
                    <span id="seconds">0</span> Secs
                </div>
            </div>
        </div>
        <div class="mt-4">
            <p>
                <strong>Date: </strong>
                <span>
                    @GetOrdinalSuffix(Model.DateStart.Day)
                    @Model.DateStart.ToString("MMM", new System.Globalization.CultureInfo("en-US"))
                    @Model.DateStart.Year
                </span>
            </p>
            <p><strong>Kick Off: </strong> <span>@Model.TimeStart</span></p>
            <p><strong>Stadium: </strong> <span>@Model.Stadium</span></p>
        </div>
        <div class="mt-4">
            <a asp-controller="Fixtures" asp-action="Index" class="btn btn-primary btn-back">Back to fixtures</a>
        </div>
    </div>
</div>

<script>
    const dateStart = "@Model.DateStart.ToString("yyyy-MM-dd")";
    const timeStart = "@Model.TimeStart.ToString("HH:mm:ss")";

    const matchStartTime = new Date(`${dateStart}T${timeStart}`);

    function updateCountdown() {
        const now = new Date();
        const diff = matchStartTime - now;

        if (diff <= 0) {
            document.getElementById("countdown").innerHTML = "Match Started!";
            clearInterval(countdownInterval);
            return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        document.getElementById("days").textContent = days;
        document.getElementById("hours").textContent = hours;
        document.getElementById("minutes").textContent = minutes;
        document.getElementById("seconds").textContent = seconds;
    }

    const countdownInterval = setInterval(updateCountdown, 1000);

    updateCountdown();
</script>