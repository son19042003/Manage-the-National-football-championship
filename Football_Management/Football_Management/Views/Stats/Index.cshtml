@model IEnumerable<Football_Management.ViewModels.Stats.StatsViewModel>
@{
    ViewData["Title"] = "Index";
}

<section class="section schedule">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title">
                    <h3><span class="alternate">Stats Goals</span></h3>
                </div>
            </div>
        </div>
        <div id="player-table" class="row">
            <div class="col-12">
                <div class="schedule-contents">
                    <div class="tab-content" id="pills-tabContent">
                        <div class="tab-pane fade show active schedule-item" id="nov20">
                            <!-- Headings -->
                            <ul class="m-0 p-0">
                                <li class="headings">
                                    <div class="rank">Rank</div>
                                    <div class="player">Player</div>
                                    <div class="subject">Club</div>
                                    <div class="venue">Stat</div>
                                </li>
                                @foreach (var player in Model)
                                {
                                    <li class="schedule-details">
                                        <div class="block">
                                            <div class="rank">
                                                <span class="rank">@player.Rank</span>
                                            </div>
                                            <!-- player -->
                                            <div class="player">
                                                <a asp-controller="Clubs" asp-action="DetailPlayer" asp-route-id="@player.PlayerId">
                                                    <span class="name">@player.PlayerName</span>
                                                </a>
                                            </div>
                                            <!-- club -->
                                            <div class="subject">
                                                <a asp-controller="Clubs" asp-action="Squad" asp-route-id="@player.ClubId">
                                                    <img src="~/Assets/images/logo/@player.LogoUrl"
                                                         alt="Logo" style="width: 40px; height: 40px">
                                                    <span>@player.ClubName</span>
                                                </a>
                                            </div>
                                            <!-- goals -->
                                            <div class="venue">@player.Goals</div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                    </div>
                </div>
            </div>
            <div id="pagination-controls" class="col-12 text-center pagination-controls">
                <!-- Pagination -->
                <nav class="d-flex justify-content-center">
                    <ul class="pagination">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1 })" class="btn btn-primary" aria-label="prev">
                                    <span aria-hidden="true"><i class="fa fa-angle-left"></i></span>
                                    <span class="sr-only">prev</span>
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @((i == ViewBag.CurrentPage) ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                            </li>
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1 })" class="btn btn-primary" aria-label="Next">
                                    <span aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                                    <span class="sr-only">Next</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</section>

<script>
    function loadPage(page) {
        fetch(`/Stats/Index?page=${page}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('player-table').innerHTML = html;
            });
    }

    // Gắn sự kiện cho nút phân trang
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('pagination-btn')) {
            e.preventDefault();
            const page = e.target.getAttribute('data-page');
            loadPage(page);
        }
    });

</script>