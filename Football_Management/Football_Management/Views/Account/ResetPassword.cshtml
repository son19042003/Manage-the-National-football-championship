@model Football_Management.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
}

<div class="banner-account">
    <h1>Your Account</h1>
</div>
<div class="container">
    <div class="registration-form">
        <h2 class="text-center">Forgot password</h2>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="@Model.Token" type="hidden" />
            <div class="mb-3">
                <label asp-for="@Model.NewPassword" for="NewPassword" class="form-label">New password</label>
                <input asp-for="@Model.NewPassword" type="password" class="form-control" required>
                <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="@Model.ConfirmNewPassword" for="NewPassword" class="form-label">Confirm new password</label>
                <input asp-for="@Model.ConfirmNewPassword" type="password" class="form-control" required>
                <span asp-validation-for="@Model.ConfirmNewPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-register w-100">Reset password</button>
            <div class="login-link">
                <p class="text-center mt-3">Remember your password? <a asp-controller="Account" asp-action="Login">Login here</a></p>
            </div>
        </form>
    </div>
</div>