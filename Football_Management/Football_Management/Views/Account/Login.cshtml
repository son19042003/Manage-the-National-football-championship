@model Football_Management.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="banner-account">
    <h1>Your Account</h1>
</div>
<div class="container mt-5" style="padding-bottom: 50px;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center">Sign In</h2>
            <form asp-action="Login" method="post">
                <div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <!-- <label for="username">Username:</label> -->
                    <input asp-for="@Model.UsernameOrEmail" type="text" class="form-control" id="username" placeholder="Username or Email" required>
                    @Html.ValidationMessageFor(model => model.UsernameOrEmail, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <!-- <label for="password">Password:</label> -->
                    <input asp-for="@Model.Password" type="password" class="form-control" id="password" placeholder="Password" required>
                    @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                </div>
                <div class="form-group d-flex justify-content-between align-items-center">
                    <div>
                        <input asp-for="@Model.RememberMe" type="checkbox" id="remember">
                        <label for="remember">Remember Me</label>
                    </div>
                    <div>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-password">Forgot Password?</a>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block">SIGN IN</button>
            </form>
            <p class="text-center mt-3">Don't have an account yet? <a asp-controller="Account" asp-action="Register">Sign Up</a>.</p>

        </div>
    </div>
</div>