@model Football_Management.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ForgotPassword";
}

<div class="banner-account">
    <h1>Your Account</h1>
</div>
<div class="container">
    <div class="registration-form">
        <h2 class="text-center">Forgot password</h2>
        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="@Model.Email" class="form-label">Enter your registered email</label>
                <input asp-for="@Model.Email" type="email" class="form-control" id="email" placeholder="Enter email" required>
                <span asp-validation-for="@Model.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-register w-100">Send reset link</button>
            <div class="login-link">
                <p class="text-center mt-3">Remember your password? <a asp-controller="Account" asp-action="Login">Login here</a></p>
            </div>
        </form>
    </div>
</div>