@model Football_Management.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "ChangePassword";
}

<div class="banner-account">
    <h1>Your Account</h1>
</div>
<div class="container">
    <div class="registration-form">
        <h2 class="text-center">Change password</h2>
        <form asp-action="ChangePassword" method="post">
            <input asp-for="@Model.AccountId" type="hidden" />
            <div class="mb-3">
                <label asp-for="@Model.CurrentPassword" for="password" class="form-label">Current password</label>
                <input asp-for="@Model.CurrentPassword" type="password" class="form-control" id="currentPassword" required>
                <span asp-validation-for="@Model.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="@Model.NewPassword" for="password" class="form-label">New password</label>
                <input asp-for="@Model.NewPassword" type="password" class="form-control" id="newPassword" required>
                <span asp-validation-for="@Model.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="@Model.ConfirmNewPassword" for="password" class="form-label">Confirm new password</label>
                <input asp-for="@Model.ConfirmNewPassword" type="password" class="form-control" id="confirmNewPassword" required>
                <span asp-validation-for="@Model.ConfirmNewPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-register w-100">Save</button>
            <div class="login-link">
                <a asp-controller="Account" asp-action="Profile" style="background-color: aqua; padding:10px; border-radius:10px">Back to your profile</a>
            </div>
        </form>
    </div>
</div>